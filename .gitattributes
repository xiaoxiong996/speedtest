# 统一 LF：shell 脚本 / 容器内文件若被转成 CRLF，Linux 上会报 "bad interpreter"
* text=auto eol=lf

*.sh   text eol=lf
*.go   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf
Dockerfile text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.conf text eol=lf
.env*  text eol=lf

# 二进制
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
