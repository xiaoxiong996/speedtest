# ===== 主控版 .env 示例（复制为 .env 后按需修改）=====
# 想从 GitHub 拉取预构建镜像而不是本地构建，填：
# IMAGE=ghcr.io/你的用户名/你的仓库名:1.2.36

APP_MODE=controller
HTTP_HOST=127.0.0.1
HOST_PORT=3333
TRUSTED_PROXIES=127.0.0.1,::1
TRUSTED_IP_HEADERS=CF-Connecting-IP,EO-Connecting-IP,Ali-Cdn-Real-Ip,X-Real-IP
PUBLIC_BASE_URL=
ADMIN_USER=admin
ADMIN_PASSWORD=请改成强密码
ADMIN_PATH=请改成隐藏路径
SITE_NAME=SpeedTest
SITE_TITLE_SUFFIX=网络测速
NODE_NAME=本地节点
NODE_LOCATION=中国
NODE_SPONSOR=自建机房
NODE_URL=
NODE_URL6=
LOG_CLIENT_IP=0
