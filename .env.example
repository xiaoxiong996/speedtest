# ============================================================================
#  主控版 .env（复制成 .env 后按需修改；每个变量都写了作用和默认值）
# ----------------------------------------------------------------------------
#  改完执行：docker compose up -d   （compose 会自动重建受影响的容器）
#  ★ 账号密码只在这里生效一次：账号建好后密码只存 data/config.json 的哈希，
#    之后改密码请到后台改；这里再写明文不会覆盖已存在的账号。
# ============================================================================

# ---------------- 镜像 ----------------
# 本地构建（docker compose build）时不用改；
# 从 GitHub 拉预构建镜像：IMAGE=ghcr.io/你的用户名/你的仓库名:latest
# IMAGE=speedtest-site:1.4.3

# ---------------- 监听与端口 ----------------
# 容器内监听地址。桥接网络下必须是 0.0.0.0，否则宿主机上的反代连不进来。
HTTP_HOST=0.0.0.0
# 宿主机对外发布的端口（反代的目标端口）。改成 8080 就访问 127.0.0.1:8080
HOST_PORT=3333
# 容器内监听端口，一般不用改；改了 HOST_PORT 不用跟着改
CONTAINER_PORT=3333
# 端口绑定地址：127.0.0.1 = 只有本机能连（配合反代，推荐）；
# 0.0.0.0 = 直接对公网开放明文端口（不推荐，等于绕过反代）
BIND_ADDR=127.0.0.1
# 容器时区，影响日志与报告时间
TZ=Asia/Shanghai

# ---------------- 桥接网络（固定网段，避免和宿主机上其它 docker 网络撞车）----------------
# 默认 172.31.240.0/24。如果你的机器上这个网段已被占用，
# 换成任意空闲网段，并把下面的 TRUSTED_PROXIES 网关地址一起改。
DOCKER_SUBNET=172.31.240.0/24
DOCKER_GATEWAY=172.31.240.1

# ---------------- 访客真实 IP 解析 ----------------
# 可信代理：只有请求来源命中这里，才会采信下面的转发头（否则防伪造直接忽略 RemoteAddr）。
# 桥接模式下来源是 docker 网关，所以必须包含上面那个网关 IP。
TRUSTED_PROXIES=127.0.0.1,::1,172.31.240.1
# 依次尝试的取 IP 头：Cloudflare / 阿里云 CDN / 腾讯云 EdgeOne / 通用反代 全覆盖，
# 换 CDN 不用改这里。顺序有意义：XFF 在 X-Real-IP 之前（Lucky 会覆盖 X-Real-IP）。
TRUSTED_IP_HEADERS=CF-Connecting-IP,True-Client-IP,Ali-Cdn-Real-Ip,Ali-Real-Ip,EO-Connecting-IP,X-Forwarded-For,X-Real-IP
# 站点对外地址，用于生成报告/分享链接；留空自动按当前请求推断
PUBLIC_BASE_URL=
# 后台登录 Cookie 作用域：多个子域指向同一后台时填 .你的域名（如 .example.com），
# 这样换子域访问不会像"刷新掉登录"；只用一个域名留空即可
ADMIN_COOKIE_DOMAIN=

# ---------------- 首次安装初始化（只在新装、config.json 不存在时生效）----------------
ADMIN_USER=admin
# 首次安装的后台密码，建好账号后请清空这一行
ADMIN_PASSWORD=
# 后台入口路径：后台地址是 https://域名/<ADMIN_PATH>，留空自动生成随机串
ADMIN_PATH=
SITE_NAME=SpeedTest
SITE_TITLE_SUFFIX=
# 说明：主控只做控制台，不再自带测速节点。
# 节点请用节点版部署后，在后台「节点」里添加，可随时增删改、调顺序、设默认。

# ---------------- 排障 ----------------
# 1 = 每个请求打印解析出的访客 IP，排查 CDN / 白名单问题时临时打开
LOG_CLIENT_IP=0
