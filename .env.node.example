# ===== 纯测速节点版 .env 示例 =====
# 用法：cp .env.node.example .env.node
#   docker compose --env-file .env.node -f docker-compose.node.yml up -d --build
# 想从 GitHub 拉镜像：把 IMAGE 填成 ghcr.io/你的用户名/仓库名:1.2.36

IMAGE=speedtest-node:1.2.36
HTTP_HOST=0.0.0.0
NODE_PORT=8443

# 只允许这些 IP 段访问测速（逗号分隔，留空=不限制）
NODE_ALLOW_CIDRS=
# 只允许这些域名访问（逗号分隔，支持 *.example.com，留空=不限制）
NODE_ALLOW_HOSTS=
# 只允许这些来源跨源调用（主控站域名，带协议；留空=任意）
NODE_ALLOW_ORIGINS=
# 测速端点 base 路径（加在 /api 前，留空=/api/ping）
NODE_PATH_PREFIX=

# 节点直连访客时下面两项留空即可；若节点也套 CDN/反代再配置
TRUSTED_PROXIES=
TRUSTED_IP_HEADERS=X-Real-IP
LOG_CLIENT_IP=0
