# ============================================================================
#  测速节点版 .env —— 每一项只写"是什么、什么时候改"
#  用法：cp .env.node.example .env && vi .env && docker compose up -d
#  规则：值两侧不要加引号，不要留行尾空格；整份文件不要出现中文引号。
# ============================================================================

# 镜像。多机部署推荐用 GitHub 构建好的（不用本地编译）
IMAGE=ghcr.io/你的用户名/你的仓库:latest

# 主控连接端口。节点只监听这一个，主控后台填 https://<域名>:<这个端口>
NODE_PORT=8445

# 证书域名：必须已解析到本机公网 IP（NAT 后填出口 IP），DNS 用灰云直连。
# 多个域名逗号分隔，第一个为主域名。Let's Encrypt 不支持纯 IP。
NODE_ACME_DOMAINS=node1.example.com

# Cloudflare API Token（该域名的 Zone.DNS:Edit 权限）。
#   填了 → 全自动：自动加 TXT、自动校验、自动删记录、到期自动续期
#   留空 → 手动：面板显示 TXT，你自己去 DNS 后台添加，点一下继续
CF_DNS_API_TOKEN=

# 证书到期前多少天自动续期
NODE_CERT_RENEW_DAYS=30

# 1 = 用 Let's Encrypt 测试环境（证书不被浏览器信任，只验证流程）
NODE_ACME_STAGING=0

# ---- 面板（隐藏路径 + 账号密码）----
# 页面地址：https://<域名>:<NODE_PORT>/<NODE_PANEL_PATH>
# 面板与测速端点共用同一个端口，不用额外开端口。
# 路径留空 = 不启用面板。
NODE_PANEL_PATH=panel-请改成自己的随机串
NODE_PANEL_USER=admin
NODE_PANEL_PASS=请改成强密码

# ---- 首次部署的 HTTP 引导窗口 ----
# 还没有证书时浏览器打不开 https 面板，所以启动后前 N 分钟额外开一个纯 HTTP 端口，
# 只用于访问面板签证书（测速端点在这个端口上返回 404）。
# 签好证书或超时后自动关闭。设 0 = 完全不开。
NODE_HTTP_BOOTSTRAP_MINUTES=10
# 引导端口，留空 = NODE_PORT+1
NODE_HTTP_PORT=

# 证书目录（容器内），签好后放这里，备份它=备份证书
NODE_CERT_DIR=/certs

# 只允许你的主控站调用，避免别人用浏览器盗用你的带宽
NODE_ALLOW_ORIGINS=https://speed.example.com

# 可选：允许的 Host（校验请求头）。用域名访问时建议填上
NODE_ALLOW_HOSTS=node1.example.com

# 可选：允许测速的访客 IP 段，单 IP / CIDR，v4 v6 可混填。留空=不限
NODE_ALLOW_CIDRS=

# 可选：端点路径前缀。留空 = /api/ping；填 /n1 = /n1/api/ping
NODE_PATH_PREFIX=

# ---- DDNS（动态 IP 必备）----
# 把域名自动指向本机当前公网 IP，格式 "域名:A,域名2:AAAA"，逗号分隔。
# 复用上面的 CF_DNS_API_TOKEN 更新 Cloudflare 记录；也可以直接在面板里加减。
NODE_DDNS=speeda.example.com:A,speedb.example.com:AAAA
# 检查间隔（分钟）
NODE_DDNS_INTERVAL=5

# 容器时区，只影响日志
TZ=Asia/Shanghai
